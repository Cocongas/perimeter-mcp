{
  "name": "perimeter-mcp",
  "version": "0.1.0",
  "description": "Checks code for common health-data mistakes, and de-identifies clinical text through a perimeter core. An MCP server for Claude Code, Codex and other clients.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "healthcare",
    "health-data",
    "phi",
    "de-identification",
    "privacy",
    "code-scanner",
    "claude",
    "codex"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Cocongas/perimeter-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cocongas/perimeter-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Cocongas/perimeter-mcp/issues"
  },
  "type": "module",
  "bin": {
    "perimeter-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
